# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# Secrets — never commit. Written by deploy/scripts/setup-anthropic-env.sh
.env
.env.*
!.env.example

# Raw probe runs: large, regenerable, and may contain long model outputs.
# Findings (findings/) are committed; transcripts are not.
transcripts/*
!transcripts/.gitkeep

# Skill run artifacts. SKILL.md writes these into the working directory, which is often a
# clone of this repo; the one committed example scorecard stays tracked (ignore rules never
# apply to already-tracked files).
enigami-scorecard-*.md
responses.json
judges.json

.DS_Store
